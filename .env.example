# Template only (no values). This file IS committed.
# All keys are server-only — never prefix with NEXT_PUBLIC_.
#
# Real values go in two gitignored files:
#   .env        -> database (Prisma CLI reads .env; Next.js reads it too)
#   .env.local  -> LLM keys

# --- LLM (put real values in .env.local) ---
# DeepSeek via the OpenAI-compatible endpoint.
#   Swap model:    change DEEPSEEK_MODEL / DEEPSEEK_MODEL_AGENT.
#   Swap provider: set DEEPSEEK_BASE_URL to any OpenAI-compatible API (with its key/model).
# Batch / no-search generation uses DEEPSEEK_MODEL (default deepseek-v4-flash, fast & cheap);
# the search agent uses DEEPSEEK_MODEL_AGENT (default deepseek-v4-pro, better reasoning).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MODEL_AGENT=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com   # optional, default shown

# --- Search (put real values in .env.local) ---
# Tavily — web search tool the fact-check agent calls (https://tavily.com)
TAVILY_API_KEY=

# --- Database (put real values in .env) ---
# Both come from Supabase dashboard -> Connect -> ORMs -> Prisma.
# DATABASE_URL = pooled connection (port 6543, has ?pgbouncer=true) — app queries
# DIRECT_URL   = direct connection (port 5432) — Prisma migrations
DATABASE_URL=
DIRECT_URL=
